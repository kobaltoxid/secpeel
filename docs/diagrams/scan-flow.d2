direction: right

vars: {
  d2-config: {
    theme-id: 3
    dark-theme-id: 200
    theme-overrides: {
      B1: "#627985"
      B3: "#EFF5F7"
      B4: "#EFF5F7"
      B5: "#EFF5F7"
      B6: "#EFF5F7"
      AA5: "#EFF5F7"
      N1: "#182A34"
      N2: "#526570"
    }
    dark-theme-overrides: {
      B1: "#8FA6B0"
      B3: "#26383F"
      B4: "#26383F"
      B5: "#26383F"
      B6: "#26383F"
      AA5: "#26383F"
      N1: "#EDF3F5"
      N2: "#BAC8CE"
    }
  }
}

classes: {
  component: {
    style: {
      border-radius: 8
      stroke-width: 1
    }
  }
  boundary: {
    style: {
      fill: transparent
      stroke: "#CBD8DF"
      stroke-width: 1
    }
  }
}

artifact: Artifact {
  shape: document
  class: component
}

bsca: {
  label: secpeel
  class: boundary
  unpack: Unpacker {
    class: component
  }
  identify: Identifiers {
    class: component
  }
  evidence: Evidence collector {
    class: component
  }
  unpack -> identify: files
  unpack -> evidence: files
}

secdepth: secdepth {
  class: component
}

artifact -> bsca.unpack
bsca.identify -> secdepth: "inventory +\nledger"
secdepth -> bsca.evidence: matches.json
bsca.evidence -> secdepth: "class and symbol\nevidence"
